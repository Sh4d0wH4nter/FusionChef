# Choose ONE backend. OpenRouter wins if OPENROUTER_API_KEY is set.

# OpenRouter (recommended). Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Tried in order if the main model errors or is rate-limited (free models often are):
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# Optional: a model that accepts audio, so the mic sends sound to it. Leave unset to use browser speech recognition.
# OPENROUTER_AUDIO_MODEL=google/gemini-2.5-flash
# OPENROUTER_MAX_TOKENS=4096

# A) Vertex AI (uses your Google Cloud credits). Run once: gcloud auth application-default login
# VERTEX_PROJECT=your-gcp-project-id
# VERTEX_LOCATION=us-central1

# A1) Your own Gemma 4 E4B deployment from Model Garden (see README). Uncomment and fill in:
# VERTEX_ENDPOINT_ID=1234567890123456789
# VERTEX_ENDPOINT_DNS=            # dedicated DNS from the endpoint's page, e.g. 1234.us-central1-987654321.prediction.vertexai.goog
# VERTEX_ENDPOINT_API=chat        # chat (OpenAI-style, default) or rawpredict
# VERTEX_ENDPOINT_MODEL=          # only if the server insists on a "model" name
# VERTEX_ENDPOINT_AUDIO=1         # set 0 to use browser speech recognition instead of sending audio
# VERTEX_MAX_TOKENS=4096

# A2) Google-hosted models, no GPU to manage: leave VERTEX_ENDPOINT_ID unset and pick a model.
#     gemma-4-26b-a4b-it-maas is the serverless Gemma (needs VERTEX_LOCATION=global; text only).
# VERTEX_MODEL=gemini-2.5-flash
# VERTEX_AUDIO_MODEL=

# If gcloud is not found (common on Mac), give its full path, e.g. /opt/homebrew/bin/gcloud
# GCLOUD_PATH=

# B) Google AI Studio key (leave VERTEX_PROJECT out, or delete it, to use this)
# GEMINI_API_KEY=your-google-ai-api-key
# GEMMA_MODEL=gemma-4-31b-it
# GEMMA_AUDIO_MODEL=

# PORT=3000
